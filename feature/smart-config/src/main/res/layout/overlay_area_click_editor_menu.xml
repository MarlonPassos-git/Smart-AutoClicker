<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false">

    <androidx.cardview.widget.CardView
        android:id="@+id/menu_background"
        style="@style/AppTheme.Overlay.FloatingMenu.CardView"
        tools:viewBindingIgnore="true">

        <LinearLayout
            android:id="@+id/menu_items"
            style="@style/AppTheme.Overlay.FloatingMenu.LayoutButtons">

            <ImageButton
                android:id="@+id/btn_confirm"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:contentDescription="@string/content_desc_confirm"
                android:src="@drawable/ic_confirm" />

            <ImageButton
                android:id="@+id/btn_cancel"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:contentDescription="@string/content_desc_go_back"
                android:src="@drawable/ic_cancel" />

            <ImageButton
                android:id="@+id/btn_add_vertex"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:contentDescription="@string/area_click_add_vertex"
                android:src="@drawable/ic_add" />

            <ImageButton
                android:id="@+id/btn_remove_vertex"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:contentDescription="@string/area_click_remove_vertex"
                android:src="@drawable/ic_delete" />

            <ImageButton
                android:id="@+id/btn_preview"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:contentDescription="@string/area_click_preview"
                android:src="@drawable/ic_area_click" />

            <ImageButton
                android:id="@+id/btn_hide_overlay"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:contentDescription="@string/area_click_hide_editor"
                android:src="@drawable/ic_visible_on" />

            <ImageButton
                android:id="@+id/btn_move"
                style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                android:contentDescription="@string/content_desc_move_menu"
                android:src="@drawable/ic_move" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</FrameLayout>
