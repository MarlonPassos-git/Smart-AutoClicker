<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppTheme.Dialog.BackgroundLayout"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include android:id="@+id/layout_top_bar" layout="@layout/include_dialog_navigation_top_bar" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default" android:orientation="vertical">
            <include android:id="@+id/field_name" layout="@layout/include_field_text_input" />
            <include android:id="@+id/field_click_count" layout="@layout/include_field_text_input" />
            <include android:id="@+id/field_press_duration" layout="@layout/include_field_text_input" />
            <include android:id="@+id/field_interval" layout="@layout/include_field_text_input" />
            <include android:id="@+id/field_distribution" layout="@layout/include_field_multi_state" />
            <include android:id="@+id/field_area" layout="@layout/include_field_selector" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
