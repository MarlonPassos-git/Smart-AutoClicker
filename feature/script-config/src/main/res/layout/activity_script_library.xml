<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:title="@string/script_library_title" app:navigationIcon="@drawable/ic_back" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true"
        android:contentDescription="@string/script_loading" android:visibility="gone" />
    <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:accessibilityLiveRegion="polite" android:textIsSelectable="true" android:visibility="gone" />

    <LinearLayout android:id="@+id/library" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/create"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/script_create" />
            <com.google.android.material.button.MaterialButton android:id="@+id/importPackage" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                android:minHeight="48dp" android:text="@string/script_import" />
        </LinearLayout>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="32dp" android:text="@string/script_empty" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <ListView android:id="@+id/packages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout android:id="@+id/details" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
        <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/files"
            android:paddingTop="16dp" android:text="@string/script_file" />
        <Spinner android:id="@+id/files" android:layout_width="match_parent" android:layout_height="48dp" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/start" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/script_start" />
                <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/script_save" />
                <com.google.android.material.button.MaterialButton android:id="@+id/validate" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/script_validate" />
                <com.google.android.material.button.MaterialButton android:id="@+id/calibrate" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/script_calibrate" />
                <com.google.android.material.button.MaterialButton android:id="@+id/exportPackage" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/script_export" />
            </LinearLayout>
        </HorizontalScrollView>
        <TextView android:id="@+id/resource" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:visibility="gone" />
        <ImageView android:id="@+id/imagePreview" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:adjustViewBounds="true" android:scaleType="fitCenter"
            android:visibility="gone" />
        <LinearLayout android:id="@+id/editorContainer" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:id="@+id/lines" android:layout_width="40dp" android:layout_height="match_parent"
                android:paddingTop="12dp" android:gravity="end" android:paddingEnd="8dp" android:fontFamily="monospace"
                android:textSize="14sp" android:importantForAccessibility="no" />
            <!-- SavedStateHandle owns the draft; duplicating it in the view state exceeds Binder for large files. -->
            <androidx.appcompat.widget.AppCompatEditText android:id="@+id/editor" android:saveEnabled="false" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:gravity="top|start" android:fontFamily="monospace"
                android:textSize="14sp" android:padding="12dp" android:inputType="textMultiLine|textNoSuggestions"
                android:scrollbars="vertical|horizontal" android:contentDescription="@string/script_editor" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
