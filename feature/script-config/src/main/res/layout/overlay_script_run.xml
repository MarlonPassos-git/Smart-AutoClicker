<com.buzbuz.smartautoclicker.feature.script.config.ScriptControlLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content" android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView android:id="@+id/menu_background" style="@style/AppTheme.Overlay.FloatingMenu.CardView"
        app:cardBackgroundColor="@color/script_overlay_background">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/state" android:layout_width="@dimen/script_overlay_expanded_width" android:layout_height="wrap_content"
                android:minHeight="@dimen/overlay_menu_btn_size"
                android:padding="12dp" android:minLines="3" android:maxLines="3" android:ellipsize="end" android:textColor="@color/overlayMenuButtons"
                android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/menu_items" style="@style/AppTheme.Overlay.FloatingMenu.LayoutButtons"
                android:orientation="horizontal" android:layout_gravity="center_horizontal">
                <ImageButton android:id="@+id/btn_play" style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                    android:src="@drawable/ic_pause" android:contentDescription="@string/script_pause" />
                <ImageButton android:id="@+id/btn_stop" style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                    android:src="@drawable/ic_stop" android:contentDescription="@string/script_stop" />
                <ImageButton android:id="@+id/btn_diagnostics" style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                    android:src="@drawable/ic_settings_filled" android:contentDescription="@string/script_diagnostics" />
                <ImageButton android:id="@+id/btn_move" style="@style/AppTheme.Overlay.FloatingMenu.Buttons"
                    android:src="@drawable/ic_move" android:contentDescription="@string/script_move" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/diagnosticScroll"
                android:layout_width="@dimen/script_overlay_expanded_width" android:layout_height="200dp" android:padding="12dp"
                android:clipToPadding="false" android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</com.buzbuz.smartautoclicker.feature.script.config.ScriptControlLayout>
