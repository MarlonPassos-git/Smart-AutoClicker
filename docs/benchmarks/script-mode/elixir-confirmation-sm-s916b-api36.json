  "scriptVariant": "Read-only confirmation inspection: appended inspectOnly to the wall module, opened elixir confirmation and stopped without dispatching the final confirmation tap.",
  "entrySource": "import { sleep, log, stop } from \"klickr\";\nimport { inspectOnly } from \"./walls.js\";\nimport { all, number, snapshot, waitSnapshot, position, tapStep, act } from \"./screen.js\";\nawait sleep(5000);\nconst selected = await inspectOnly({goldReserve: 0, elixirReserve: 0});\nawait log(JSON.stringify({kind:\"dry_wall_selection\", results:selected.results}));\nif (!await act(selected, [tapStep(position(selected, \"elixirPay\"))])) await stop(\"Seleção invalidada; inspeção encerrada sem pagamento.\");\nconst names = [\"singleTitle\", \"elixirConfirm\", \"singleConfirmCost\", \"confirmGreen1\", \"confirmGreen2\"];\nconst checked = await waitSnapshot(\"inspecionar confirmação sem pagamento\", names,\n    current => all(current, [\"singleTitle\", \"elixirConfirm\", \"confirmGreen1\", \"confirmGreen2\"]) && number(current.results.singleConfirmCost) === 2000000,\n    {timeoutMs:5000,intervalMs:100,required:false});\nconst current = checked ?? await snapshot(names);\nawait log(JSON.stringify({kind:\"dry_elixir_confirmation\", verified:checked !== null, results:current.results}));\nawait stop(\"Inspeção encerrada antes do pagamento; nenhuma melhoria autorizada pelo roteiro.\");\n",
